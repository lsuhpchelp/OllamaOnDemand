#!/usr/bin/env bash

# Purge any auto loaded module
module purge

# Unset incorrect ROCR settings that causes Ollama not to use GPU
# You may or may not need this depending on your system setting, or if you use AMD GPU
unset ROCR_VISIBLE_DEVICES

# Start Ollama OnDemand service
singularity run --nv /path/to/ollamaondemand.sif \
    --debug \
    -w <%=context.work_dir%> \
    --port $port \
    --root-path /rnode/$host/$port \
    --ollama-host 127.0.0.1:$port_ollama \
    --ollama-models /path/to/admin/maintained/model/location

